{
  "manifest_version": 3,
  "name": "Aicus",
  "version": "1.3.0",
  "description": "ChatGPT·Claude·Gemini 긴 대화에서 내 질문만 모아 보여주고 클릭 한 번으로 이동. 전체 질문 불러오기, 즐겨찾기 지원.",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://gemini.google.com/app*",
        "https://bard.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aicus - Chat Navigator"
  },
  "web_accessible_resources": [
    {
      "resources": ["docs/daram-qr.png", "docs/coffee-qr.png"],
      "matches": ["<all_urls>"]
    }
  ]
}